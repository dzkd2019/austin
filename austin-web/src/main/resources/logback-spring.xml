<?xml version="1.0" encoding="UTF-8"?>

<configuration scan="true" scanPeriod="10 seconds">

    <contextName>austin</contextName>

    <!-- 日志输出根路径 -->
    <property name="log.path" value="logs"/>

    <!-- 将 Spring 活跃 profile 注入为 Logback 属性，供 LogstashEncoder customFields 使用 -->
    <springProperty scope="context" name="springProfile" source="spring.profiles.active" defaultValue="default"/>

    <!-- ===================== Console Appender ===================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} [traceId=%X{traceId}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        JSON 滚动文件 Appender（原始同步写入，不应直接引用）
        使用 logstash-logback-encoder 输出纯 JSON，每行一条记录，便于 Promtail 采集。
        MDC 字段（traceId、messageId、requestPath、userId、kafkaTopic）会自动包含在
        JSON 的 "mdc" 对象中，供 LogQL 过滤使用——绝不作为 Loki Label，避免高基数灾难。
    -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/austin-app.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- 固定低基数字段，作为 Loki Label 的数据来源 -->
            <customFields>{"app":"austin","env":"${springProfile}"}</customFields>
            <!-- 输出所有 MDC 字段到 JSON（traceId / messageId / requestPath / userId / kafkaTopic 等） -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>messageId</includeMdcKeyName>
            <includeMdcKeyName>requestPath</includeMdcKeyName>
            <includeMdcKeyName>businessId</includeMdcKeyName>
            <includeMdcKeyName>kafkaGroupId</includeMdcKeyName>
            <!-- 不记录调用方行号，避免高并发下的额外栈帧解析开销 -->
            <includeCallerData>false</includeCallerData>
        </encoder>
        <!-- 按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/archive/austin-app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>500MB</maxFileSize>
            <!-- 保留最近 7 天的归档日志 -->
            <maxHistory>7</maxHistory>
            <!-- 所有归档文件总大小上限，防止磁盘写满 -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!--
        异步 JSON 文件 Appender（高并发安全版）
        - queueSize=4096：较大的内存队列，缓冲瞬时写入洪峰，减少业务线程等待。
        - discardingThreshold=0：不因队列水位主动丢弃日志（默认 20% 时会丢弃 TRACE/DEBUG）。
        - neverBlock=true：队列满时直接丢弃最新日志，绝不阻塞业务线程（含虚拟线程）。
        - includeCallerData=false：不复制调用栈帧，降低异步化本身的 CPU 开销。
    -->
    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ===================== Profile-based root logger ===================== -->

    <!-- dev 环境：只输出到控制台，不写文件，减少本地开发磁盘 I/O -->
    <springProfile name="dev">
        <root level="info">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- test 环境：控制台 + 异步 JSON 文件（Promtail 可从文件采集） -->
    <springProfile name="test">
        <root level="info">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>
    </springProfile>

    <!-- prod 环境：仅异步 JSON 文件，由 Promtail 采集后推送至 Loki -->
    <springProfile name="prod">
        <root level="info">
            <appender-ref ref="ASYNC_JSON_FILE"/>
        </root>
    </springProfile>

</configuration>
